FLAXON_ENV=development
FLAXON_LABS_DATA_DIR=var
FLAXON_ADMIN_STORAGE_PATH=var/admin.sqlite3
FLAXON_SECRET_KEY=replace-with-a-long-random-secret
FLAXON_ADMIN_USERNAME=aldane
FLAXON_ADMIN_PASSWORD=replace-with-a-strong-password
FLAXON_ADMIN_EMAIL=aldane@example.com
SITE_URL=http://127.0.0.1:8000
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
REDIS_URL=redis://localhost:6379/0
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
BLOB_PUBLIC_URL=https://your-public-blob-domain
GITHUB_ORG=Flaxon-Labs
GITHUB_TOKEN=
SMTP_HOST=smtp.example.com
SMTP_ENABLED=true
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Flaxon Labs <no-reply@example.com>
SMTP_TLS=true
SMTP_USE_TLS=true
FLAXON_HOST=127.0.0.1
FLAXON_PORT=8000
FLAXON_RELOAD=true
